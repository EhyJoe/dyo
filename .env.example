# MongoDB (server-only; never prefix these with NEXT_PUBLIC_)
MONGODB_URI=
MONGODB_DB=dyo

# Authentication secret for the new server-side session system (minimum 32 random bytes)
AUTH_SECRET=

# Password reset email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional absolute base URL used in account and programme emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (server-only; never prefix these with NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
